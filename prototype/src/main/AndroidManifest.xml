<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:theme="@android:style/Theme.Material.Light.NoActionBar" android:label="@string/app_name" android:allowBackup="false" android:icon="@drawable/ic_keyboard" android:supportsRtl="true">
        <activity android:name=".SettingsActivity" android:exported="true" android:theme="@style/Theme.Glide.Settings" android:windowSoftInputMode="adjustResize">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <activity android:name=".LayoutSettingsActivity" android:exported="false" android:theme="@style/Theme.Glide.Settings" />
        <service android:name=".GlideInputMethodService" android:label="@string/app_name"
            android:exported="true" android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter><action android:name="android.view.InputMethod" /></intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/input_method" />
        </service>
    </application>
</manifest>
